#include <iostream>
#include <fstream>
#include <sstream>
#include <vector>
#include <random>
#include <chrono>
#include <memory>
#include <string>

#ifdef _OPENMP
#include <omp.h>
#endif

// ----------------------------------------------------------------------
// Forward declarations
// ----------------------------------------------------------------------
class CMatrix;
class CFabric;

// ----------------------------------------------------------------------
// Abstract factory
// ----------------------------------------------------------------------
class CFabric {
public:
    virtual CMatrix* CreateMatrix(int rows, int cols) const = 0;
    virtual ~CFabric() = default;
};

// ----------------------------------------------------------------------
// Abstract matrix class
// ----------------------------------------------------------------------
class CMatrix {
public:
    virtual ~CMatrix() = default;
    virtual CMatrix* Multiply(const CMatrix& other) const = 0;

    static int Input1(const char* filename, std::vector<CMatrix*>& v,
                      const std::vector<CFabric*>& fabrics);
    static int Input2(const char* filename, std::vector<CMatrix*>& v,
                      const std::vector<CFabric*>& fabrics);

    int GetRows() const { return m_; }
    int GetCols() const { return n_; }

    // Public access to raw data for fast multiplication
    const std::vector<int>& GetData() const { return data_; }
    std::vector<int>& GetData() { return data_; }

protected:
    CMatrix(int rows, int cols) : m_(rows), n_(cols), data_(rows * cols, 0) {}

    void SetElement(int i, int j, int value) { data_[i * n_ + j] = value; }
    int  GetElement(int i, int j) const { return data_[i * n_ + j]; }

    int m_, n_;
    std::vector<int> data_;
};

// ----------------------------------------------------------------------
// Serial multiplication (i-k-j order, raw pointers)
// ----------------------------------------------------------------------
class CMatrixSerial : public CMatrix {
public:
    CMatrixSerial(int rows, int cols) : CMatrix(rows, cols) {}

    CMatrix* Multiply(const CMatrix& other) const override {
        if (n_ != other.GetRows())
            throw std::runtime_error("Incompatible dimensions");

        CMatrixSerial* result = new CMatrixSerial(m_, other.GetCols());
        const int M = m_, K = n_, N = other.GetCols();
        const int* A = data_.data();
        const int* B = other.GetData().data();
        int* C = result->GetData().data();

        std::vector<int> row_buffer(N, 0);

        for (int i = 0; i < M; ++i) {
            std::fill(row_buffer.begin(), row_buffer.end(), 0);
            for (int k = 0; k < K; ++k) {
                int aik = A[i * K + k];
                const int* B_row = B + k * N;
                for (int j = 0; j < N; ++j) {
                    row_buffer[j] += aik * B_row[j];
                }
            }
            std::copy(row_buffer.begin(), row_buffer.end(), C + i * N);
        }
        return result;
    }
};

// ----------------------------------------------------------------------
// Parallel multiplication (OpenMP, per-thread row buffer, i-k-j)
// ----------------------------------------------------------------------
class CMatrixParallel : public CMatrix {
public:
    CMatrixParallel(int rows, int cols) : CMatrix(rows, cols) {}

    CMatrix* Multiply(const CMatrix& other) const override {
        if (n_ != other.GetRows())
            throw std::runtime_error("Incompatible dimensions");

        CMatrixParallel* result = new CMatrixParallel(m_, other.GetCols());
        const int M = m_, K = n_, N = other.GetCols();
        const int* A = data_.data();
        const int* B = other.GetData().data();
        int* C = result->GetData().data();

        #pragma omp parallel
        {
            // Каждый поток выделяет буфер только один раз
            std::vector<int> row_buffer(N, 0);

            #pragma omp for schedule(static)
            for (int i = 0; i < M; ++i) {
                std::fill(row_buffer.begin(), row_buffer.end(), 0);
                for (int k = 0; k < K; ++k) {
                    int aik = A[i * K + k];
                    const int* B_row = B + k * N;
                    for (int j = 0; j < N; ++j) {
                        row_buffer[j] += aik * B_row[j];
                    }
                }
                std::copy(row_buffer.begin(), row_buffer.end(), C + i * N);
            }
        }
        return result;
    }
};

// ----------------------------------------------------------------------
// Factories
// ----------------------------------------------------------------------
class CFabricSerial : public CFabric {
public:
    CMatrix* CreateMatrix(int rows, int cols) const override {
        return new CMatrixSerial(rows, cols);
    }
};

class CFabricParallel : public CFabric {
public:
    CMatrix* CreateMatrix(int rows, int cols) const override {
        return new CMatrixParallel(rows, cols);
    }
};

// ----------------------------------------------------------------------
// Static input methods (unchanged)
// ----------------------------------------------------------------------
int CMatrix::Input1(const char* filename, std::vector<CMatrix*>& v,
                    const std::vector<CFabric*>& fabrics) {
    if (fabrics.empty()) return -1;
    std::ifstream ifs(filename);
    if (!ifs) return -1;
    std::vector<std::string> lines;
    std::string line;
    while (std::getline(ifs, line))
        if (!line.empty()) lines.push_back(line);
    if (lines.empty()) return -1;

    std::istringstream iss0(lines[0]);
    int cols = 0, val;
    while (iss0 >> val) ++cols;
    if (cols == 0) return -1;
    int rows = (int)lines.size();

    CMatrix* mat = fabrics[0]->CreateMatrix(rows, cols);
    if (!mat) return -1;
    for (int i = 0; i < rows; ++i) {
        std::istringstream iss(lines[i]);
        for (int j = 0; j < cols; ++j) {
            if (!(iss >> val)) return -1;
            mat->SetElement(i, j, val);
        }
    }
    v.push_back(mat);
    return 0;
}

int CMatrix::Input2(const char* filename, std::vector<CMatrix*>& v,
                    const std::vector<CFabric*>& fabrics) {
    if (fabrics.size() < 2) return -1;
    std::ifstream ifs(filename);
    if (!ifs) return -1;
    std::vector<std::string> lines;
    std::string line;
    while (std::getline(ifs, line))
        if (!line.empty()) lines.push_back(line);
    if (lines.empty()) return -1;

    std::istringstream iss0(lines[0]);
    int cols = 0, val;
    while (iss0 >> val) ++cols;
    if (cols == 0) return -1;
    int rows = (int)lines.size();

    CMatrix* mat = fabrics[1]->CreateMatrix(rows, cols);
    if (!mat) return -1;
    for (int i = 0; i < rows; ++i) {
        std::istringstream iss(lines[i]);
        for (int j = 0; j < cols; ++j) {
            if (!(iss >> val)) return -1;
            mat->SetElement(i, j, val);
        }
    }
    v.push_back(mat);
    return 0;
}

// ----------------------------------------------------------------------
// Generate matrix file (m rows, n integers each)
// ----------------------------------------------------------------------
void GenerateMatrixFile(const char* filename, int m, int n) {
    std::ofstream ofs(filename);
    if (!ofs) {
        std::cerr << "Cannot open " << filename << " for writing\n";
        return;
    }
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_int_distribution<int> dist(0, 200);
    for (int i = 0; i < m; ++i) {
        for (int j = 0; j < n; ++j) {
            ofs << dist(gen);
            if (j < n - 1) ofs << " ";
        }
        ofs << "\n";
    }
}

// ----------------------------------------------------------------------
// main
// ----------------------------------------------------------------------
int main() {
    int m, n;
    std::cout << "Enter m and n: ";
    std::cin >> m >> n;
    if (m <= 0 || n <= 0) return 1;

    GenerateMatrixFile("input1.txt", m, n);
    GenerateMatrixFile("input2.txt", n, m);
    GenerateMatrixFile("input3.txt", m, n);
    GenerateMatrixFile("input4.txt", n, m);

    CFabricSerial fSer;
    CFabricParallel fPar;
    std::vector<CFabric*> fabrics = { &fSer, &fPar };
    std::vector<CMatrix*> mSerial, mParallel;

    if (CMatrix::Input1("input1.txt", mSerial, fabrics) ||
        CMatrix::Input1("input2.txt", mSerial, fabrics) ||
        CMatrix::Input2("input3.txt", mParallel, fabrics) ||
        CMatrix::Input2("input4.txt", mParallel, fabrics)) {
        std::cerr << "Read error\n";
        return 1;
    }

#ifdef _OPENMP
    std::cout << "OpenMP threads: " << omp_get_max_threads() << std::endl;
#else
    std::cout << "OpenMP NOT enabled\n";
#endif

    // --- Serial ---
    auto start = std::chrono::high_resolution_clock::now();
    CMatrix* resS = mSerial[0]->Multiply(*mSerial[1]);
    auto end = std::chrono::high_resolution_clock::now();
    auto serialTime = std::chrono::duration_cast<std::chrono::microseconds>(end - start).count();

    // --- Parallel ---
    start = std::chrono::high_resolution_clock::now();
    CMatrix* resP = mParallel[0]->Multiply(*mParallel[1]);
    end = std::chrono::high_resolution_clock::now();
    auto parallelTime = std::chrono::duration_cast<std::chrono::microseconds>(end - start).count();

    std::cout << "Serial time:   " << serialTime << " us (" << serialTime/1e6 << " s)\n";
    std::cout << "Parallel time: " << parallelTime << " us (" << parallelTime/1e6 << " s)\n";

    delete resS;
    delete resP;
    for (auto* p : mSerial) delete p;
    for (auto* p : mParallel) delete p;

    return 0;
}
