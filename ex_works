// Абстрактный класс перестановок
class Permutations {
protected:
    std::vector<int> P;
public:
    Permutations() : P() {
        std::cout << "Default constructor" << std::endl;
    }
    Permutations(size_t size) {
        std::cout << "Size constructor" << std::endl;
        if (size > 0) {
            for (size_t i = 1; i <= size; ++i) P.push_back(i);
        }
    }
    // Конструктор, принимающий готовый вектор
    Permutations(const std::vector<int>& data) : P(data) {
        std::cout << "Vector constructor" << std::endl;
    }
    virtual ~Permutations() {}

    virtual void Show() = 0;

    static int Input(const char* filename,
                     std::vector<Permutations*>& v,
                     const std::vector<class CFabric*>& fabrics);
};

// Фабрика
class CFabric {
public:
    virtual ~CFabric() { std::cout << "Fabric destructor" << std::endl; }
    virtual Permutations* Create(const std::vector<int>& data) = 0;
    virtual int GetType() const = 0;   // 0 - чётные, 1 - нечётные
};

class OddFabric : public CFabric {
public:
    Permutations* Create(const std::vector<int>& data) override;
    int GetType() const override { return 1; }
};

class EvenFabric : public CFabric {
public:
    Permutations* Create(const std::vector<int>& data) override;
    int GetType() const override { return 0; }
};

// Нечётная перестановка
class Odd : public Permutations {
public:
    using Permutations::Permutations;   // наследуем все конструкторы
    ~Odd() override {}
    void Show() override {
        std::cout << "Odd: [";
        for (size_t i = 0; i < P.size(); ++i) {
            std::cout << P[i] << " ";
        }
        std::cout << "]" << std::endl;
    }
};

// Чётная перестановка
class Even : public Permutations {
public:
    using Permutations::Permutations;
    ~Even() override {}
    void Show() override {
        std::cout << "Even: [";
        for (size_t i = 0; i < P.size(); ++i) {
            std::cout << P[i] << " ";
        }
        std::cout << "]" << std::endl;
    }
};

// Реализация фабрик
Permutations* OddFabric::Create(const std::vector<int>& data) {
    return new Odd(data);
}

Permutations* EvenFabric::Create(const std::vector<int>& data) {
    return new Even(data);
}

// Чтение файла, подсчёт инверсий и создание объектов
int Permutations::Input(const char* filename,
                        std::vector<Permutations*>& v,
                        const std::vector<CFabric*>& fabrics) {
    std::ifstream f(filename);
    if (!f.is_open()) {
        std::cerr << "Cannot open file " << filename << std::endl;
        return 1;
    }

    std::string line;
    while (std::getline(f, line)) {
        if (line.empty()) continue;
        std::stringstream ss(line);
        std::vector<int> data;
        int number;
        while (ss >> number) {
            data.push_back(number);
        }
        if (data.empty()) continue;

        // Подсчёт инверсий непосредственно здесь
        int inv = 0;
        for (size_t i = 0; i < data.size(); ++i)
            for (size_t j = i + 1; j < data.size(); ++j)
                if (data[i] > data[j]) ++inv;

        int type = inv % 2;   // 0 – чётная, 1 – нечётная

        Permutations* obj = nullptr;
        for (auto* fab : fabrics) {
            if (fab->GetType() == type) {
                obj = fab->Create(data);
                break;
            }
        }
        if (obj) v.push_back(obj);
        else std::cerr << "Unknown type " << type << " in line: " << line << std::endl;
    }
    return 0;
}

// Генерация случайных перестановок в файл
void GenerateRandomPermutations(const char* filename, int count, int maxLength) {
    std::ofstream f(filename);
    if (!f.is_open()) {
        std::cerr << "Cannot create file " << filename << std::endl;
        return;
    }

    std::mt19937 rng(std::time(nullptr));
    for (int k = 0; k < count; ++k) {
        int n = std::uniform_int_distribution<int>(2, maxLength)(rng);
        std::vector<int> perm(n);
        std::iota(perm.begin(), perm.end(), 1);
        std::shuffle(perm.begin(), perm.end(), rng);
        for (size_t i = 0; i < perm.size(); ++i) {
            f << perm[i] << (i + 1 < perm.size() ? " " : "");
        }
        f << "\n";
    }
    f.close();
}

int main() {
    const char* fileName = "input.txt";

    // Генерируем файл с 10 случайными перестановками длиной от 2 до 6
    GenerateRandomPermutations(fileName, 10, 6);

    std::vector<Permutations*> objects;
    std::vector<CFabric*> fabrics;
    fabrics.push_back(new EvenFabric);
    fabrics.push_back(new OddFabric);

    Permutations::Input(fileName, objects, fabrics);

    for (auto* obj : objects) obj->Show();

    // Очистка памяти
    for (auto* obj : objects) delete obj;
    for (auto* fab : fabrics) delete fab;

    return 0;
}


