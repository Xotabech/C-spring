import sys
import math

# ============================================================
# Алгоритм Брезенхема для отрезка
# ============================================================
def draw_line(pixels, width, height, x0, y0, x1, y1):
    dx = abs(x1 - x0)
    dy = -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    x, y = x0, y0
    while True:
        if 0 <= x < width and 0 <= y < height:
            idx = (y * width + x) * 3
            pixels[idx] = pixels[idx+1] = pixels[idx+2] = 255
        if x == x1 and y == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy
            x += sx
        if e2 <= dx:
            err += dx
            y += sy

# ============================================================
# Сохранение в PPM
# ============================================================
def save_ppm(filename, width, height, pixels):
    with open(filename, 'wb') as f:
        f.write(f'P6\n{width} {height}\n255\n'.encode())
        f.write(bytes(pixels))

# ============================================================
# Вспомогательные функции линейной алгебры
# ============================================================
def det2(a, b, c, d):
    return a * d - b * c

def det3(m):
    return (m[0][0] * (m[1][1] * m[2][2] - m[1][2] * m[2][1]) -
            m[0][1] * (m[1][0] * m[2][2] - m[1][2] * m[2][0]) +
            m[0][2] * (m[1][0] * m[2][1] - m[1][1] * m[2][0]))

def solve2(a, b, c, d, e, f):
    det = a * d - b * c
    if abs(det) < 1e-12:
        return None
    return ((e * d - b * f) / det, (a * f - e * c) / det)

# ============================================================
# Классификация и параметры кривой
# ============================================================
class Conic:
    def __init__(self, A, b_half, C, d_half, e_half, F):
        self.A = A
        self.B = 2 * b_half
        self.C = C
        self.D = 2 * d_half
        self.E = 2 * e_half
        self.F = F

        M = [[self.A, self.B, self.D],
             [self.B, self.C, self.E],
             [self.D, self.E, self.F]]
        self.I1 = self.A + self.C
        self.I2 = det2(self.A, self.B, self.B, self.C)
        self.I3 = det3(M)
        self.K1 = det2(self.A, self.D, self.D, self.F) + det2(self.C, self.E, self.E, self.F)

        self.type = None
        self.params = {}
        self._classify()

    def _classify(self):
        I1, I2, I3, K1 = self.I1, self.I2, self.I3, self.K1

        match (I2, I3, K1):
            case (I2, I3, _) if I2 > 0 and I3 != 0:
                self.type = 'ellipse' if I3 * I1 < 0 else 'imaginary_ellipse'
            case (I2, 0, _) if I2 > 0:
                self.type = 'imaginary_intersecting_lines'
            case (I2, I3, _) if I2 < 0 and I3 != 0:
                self.type = 'hyperbola'
            case (I2, 0, _) if I2 < 0:
                self.type = 'intersecting_lines'
            case (0, I3, _) if I3 != 0:
                self.type = 'parabola'
            case (0, 0, K1) if K1 < 0:
                self.type = 'parallel_lines'
            case (0, 0, K1) if K1 > 0:
                self.type = 'imaginary_parallel_lines'
            case (0, 0, 0):
                self.type = 'coincident_lines'
            case _:
                self.type = 'unknown'

        self._compute_params()

    def _compute_params(self):
        A, B, C, D, E, F = self.A, self.B, self.C, self.D, self.E, self.F
        if abs(A - C) < 1e-12:
            self.phi = math.pi / 4
        else:
            self.phi = 0.5 * math.atan2(2 * B, A - C)

        cos_p = math.cos(self.phi)
        sin_p = math.sin(self.phi)
        A1 = A * cos_p**2 + 2 * B * sin_p * cos_p + C * sin_p**2
        C1 = A * sin_p**2 - 2 * B * sin_p * cos_p + C * cos_p**2
        D1 = D * cos_p + E * sin_p
        E1 = -D * sin_p + E * cos_p
        self.A1 = A1
        self.C1 = C1
        self.D1 = D1
        self.E1 = E1
        self.cos_p = cos_p
        self.sin_p = sin_p

        if self.type in ('ellipse', 'imaginary_ellipse', 'hyperbola', 'imaginary_intersecting_lines', 'intersecting_lines'):
            center = solve2(A, B, B, C, -D, -E)
            if center is None:
                self.center = (0, 0)
            else:
                self.center = center
            x0, y0 = self.center
            F1 = D * x0 + E * y0 + F
            self.F1 = F1
            if self.type in ('ellipse', 'imaginary_ellipse'):
                if abs(A1) > 1e-12 and abs(C1) > 1e-12:
                    a2 = -F1 / A1
                    b2 = -F1 / C1
                    if a2 > 0 and b2 > 0:
                        self.a = math.sqrt(a2)
                        self.b = math.sqrt(b2)
                    else:
                        self.a = self.b = 0
                else:
                    self.a = self.b = 0
            elif self.type == 'hyperbola':
                if A1 > 0 and C1 < 0:
                    a2 = -F1 / A1
                    b2 = F1 / C1
                else:
                    a2 = -F1 / C1
                    b2 = F1 / A1
                if a2 > 0 and b2 > 0:
                    self.a = math.sqrt(a2)
                    self.b = math.sqrt(b2)
                else:
                    self.a = self.b = 0
            elif self.type == 'intersecting_lines':
                k = math.sqrt(-self.C1 / self.A1) if abs(self.A1) > 1e-12 else 0
                self.params['slopes'] = (k, -k)
            elif self.type == 'imaginary_intersecting_lines':
                self.params['point'] = (0, 0)

        elif self.type == 'parabola':
            if abs(self.C1) < 1e-12:
                if abs(self.A1) > 1e-12:
                    x0_prime = -self.D1 / self.A1
                    new_F = self.F - self.D1**2 / self.A1
                    y0_prime = -new_F / (2 * self.E1) if abs(self.E1) > 1e-12 else 0
                    self.p = -self.E1 / self.A1 if abs(self.E1) > 1e-12 else 0
                    self.vertex_prime = (x0_prime, y0_prime)
                    self.axis = 'x'
                else:
                    self.p = 0
            else:
                if abs(self.C1) > 1e-12:
                    y0_prime = -self.E1 / self.C1
                    new_F = self.F - self.E1**2 / self.C1
                    x0_prime = -new_F / (2 * self.D1) if abs(self.D1) > 1e-12 else 0
                    self.p = -self.D1 / self.C1 if abs(self.D1) > 1e-12 else 0
                    self.vertex_prime = (x0_prime, y0_prime)
                    self.axis = 'y'
                else:
                    self.p = 0

        elif self.type in ('parallel_lines', 'imaginary_parallel_lines', 'coincident_lines'):
            if abs(self.A1) > 1e-12:
                disc = self.D1**2 - self.A1 * self.F
                if disc >= 0:
                    x1 = (-self.D1 + math.sqrt(disc)) / self.A1
                    x2 = (-self.D1 - math.sqrt(disc)) / self.A1
                    self.params['lines'] = [('vertical', x1), ('vertical', x2)]
                else:
                    self.params['lines'] = []
            elif abs(self.C1) > 1e-12:
                disc = self.E1**2 - self.C1 * self.F
                if disc >= 0:
                    y1 = (-self.E1 + math.sqrt(disc)) / self.C1
                    y2 = (-self.E1 - math.sqrt(disc)) / self.C1
                    self.params['lines'] = [('horizontal', y1), ('horizontal', y2)]
                else:
                    self.params['lines'] = []
            else:
                self.params['lines'] = [('general', self.D1, self.E1, self.F)]

    def get_points(self, num_points=400):
        pts = []
        cos_p, sin_p = self.cos_p, self.sin_p
        if self.type in ('ellipse', 'imaginary_ellipse'):
            if self.a > 0 and self.b > 0:
                for i in range(num_points):
                    t = 2 * math.pi * i / num_points
                    X = self.a * math.cos(t)
                    Y = self.b * math.sin(t)
                    x = cos_p * X - sin_p * Y + self.center[0]
                    y = sin_p * X + cos_p * Y + self.center[1]
                    pts.append((x, y))
        elif self.type == 'hyperbola':
            if self.a > 0 and self.b > 0:
                t_max = 4.0
                dt = 2 * t_max / num_points
                for i in range(num_points):
                    t = -t_max + i * dt
                    X = self.a * math.cosh(t)
                    Y = self.b * math.sinh(t)
                    x = cos_p * X - sin_p * Y + self.center[0]
                    y = sin_p * X + cos_p * Y + self.center[1]
                    pts.append((x, y))
                for i in range(num_points):
                    t = -t_max + i * dt
                    X = -self.a * math.cosh(t)
                    Y = self.b * math.sinh(t)
                    x = cos_p * X - sin_p * Y + self.center[0]
                    y = sin_p * X + cos_p * Y + self.center[1]
                    pts.append((x, y))
        elif self.type == 'parabola':
            limit = abs(self.p) * 4 + 20
            step = 2 * limit / num_points
            if self.axis == 'x':
                for i in range(num_points):
                    Y = -limit + i * step
                    X = Y * Y / (2 * self.p) if self.p != 0 else 0
                    X += self.vertex_prime[0]
                    Y += self.vertex_prime[1]
                    x = cos_p * X - sin_p * Y
                    y = sin_p * X + cos_p * Y
                    pts.append((x, y))
            else:
                for i in range(num_points):
                    X = -limit + i * step
                    Y = X * X / (2 * self.p) if self.p != 0 else 0
                    X += self.vertex_prime[0]
                    Y += self.vertex_prime[1]
                    x = cos_p * X - sin_p * Y
                    y = sin_p * X + cos_p * Y
                    pts.append((x, y))
        elif self.type == 'intersecting_lines':
            k = self.params['slopes'][0]
            limit = 200
            pts.append((cos_p * (-limit) - sin_p * (-k*limit) + self.center[0],
                        sin_p * (-limit) + cos_p * (-k*limit) + self.center[1]))
            pts.append((cos_p * limit - sin_p * (k*limit) + self.center[0],
                        sin_p * limit + cos_p * (k*limit) + self.center[1]))
            pts.append((None, None))
            pts.append((cos_p * (-limit) - sin_p * (k*limit) + self.center[0],
                        sin_p * (-limit) + cos_p * (k*limit) + self.center[1]))
            pts.append((cos_p * limit - sin_p * (-k*limit) + self.center[0],
                        sin_p * limit + cos_p * (-k*limit) + self.center[1]))
        elif self.type == 'imaginary_intersecting_lines':
            x, y = self.center
            pts.append((x, y))
        elif self.type in ('parallel_lines', 'imaginary_parallel_lines', 'coincident_lines'):
            limit = 200
            for line in self.params.get('lines', []):
                if line[0] == 'vertical':
                    x_val = line[1]
                    p1 = (cos_p * x_val - sin_p * (-limit),
                          sin_p * x_val + cos_p * (-limit))
                    p2 = (cos_p * x_val - sin_p * limit,
                          sin_p * x_val + cos_p * limit)
                    pts.append(p1)
                    pts.append(p2)
                    pts.append((None, None))
                elif line[0] == 'horizontal':
                    y_val = line[1]
                    p1 = (cos_p * (-limit) - sin_p * y_val,
                          sin_p * (-limit) + cos_p * y_val)
                    p2 = (cos_p * limit - sin_p * y_val,
                          sin_p * limit + cos_p * y_val)
                    pts.append(p1)
                    pts.append(p2)
                    pts.append((None, None))
                elif line[0] == 'general':
                    a, b, c = line[1], line[2], line[3]
                    if abs(b) > 1e-12:
                        y1 = -limit; x1 = (-c - b*y1)/a
                        y2 = limit; x2 = (-c - b*y2)/a
                    else:
                        x1 = -limit; y1 = (-c - a*x1)/b
                        x2 = limit; y2 = (-c - a*x2)/b
                    p1 = (cos_p * x1 - sin_p * y1, sin_p * x1 + cos_p * y1)
                    p2 = (cos_p * x2 - sin_p * y2, sin_p * x2 + cos_p * y2)
                    pts.append(p1)
                    pts.append(p2)
                    pts.append((None, None))
        return pts

# ============================================================
# Главная программа
# ============================================================
def main():
    print("Введите 6 чисел через пробел: A, b, C, d, e, F")
    print("(b, d, e – половинные коэффициенты, будут удвоены)")
    try:
        line = sys.stdin.readline()
        parts = line.strip().split()
        if len(parts) != 6:
            raise ValueError
        A, bh, C, dh, eh, F = map(float, parts)
    except:
        print("Ошибка ввода.")
        return

    conic = Conic(A, bh, C, dh, eh, F)
    print(f"Тип кривой: {conic.type}")

    points = conic.get_points(num_points=400)
    all_x = [p[0] for p in points if p[0] is not None]
    all_y = [p[1] for p in points if p[1] is not None]
    if not all_x:
        print("Нечего рисовать.")
        return
    margin = 20
    min_x = int(min(all_x)) - margin
    max_x = int(max(all_x)) + margin
    min_y = int(min(all_y)) - margin
    max_y = int(max(all_y)) + margin
    width = max_x - min_x + 1
    height = max_y - min_y + 1
    pixels = bytearray(width * height * 3)

    prev = None
    for p in points:
        if p[0] is None:
            prev = None
            continue
        x, y = int(round(p[0])), int(round(p[1]))
        ix = x - min_x
        iy = y - min_y
        if prev is not None:
            draw_line(pixels, width, height, prev[0], prev[1], ix, iy)
        prev = (ix, iy)

    save_ppm("conic.ppm", width, height, pixels)
    print("Изображение сохранено в conic.ppm")

if __name__ == "__main__":
    main()
