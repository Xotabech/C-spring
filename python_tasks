def draw_circle(xc: int, yc: int, r: int, filename: str) -> None:
    """
    Рисует окружность по алгоритму Брезенхэма (метод средней точки)
    и сохраняет в файл.
    """
    # Границы холста: описываем квадрат вокруг окружности
    min_x = xc - r
    max_x = xc + r
    min_y = yc - r
    max_y = yc + r
    margin = 5
    width = max_x - min_x + 2 * margin + 1
    height = max_y - min_y + 2 * margin + 1

    img = Image.new('L', (width, height), 0)
    pixels = img.load()

    shift_x = -min_x + margin
    shift_y = -min_y + margin

    x = 0
    y = r
    d = 1 - r   # начальное значение управляющей переменной

    # Вспомогательная функция для рисования 8 симметричных точек
    def draw_symmetric(x, y):
        for sx, sy in [(x, y), (-x, y), (x, -y), (-x, -y),
                       (y, x), (-y, x), (y, -x), (-y, -x)]:
            # Проверяем границы холста (на всякий случай)
            px = xc + sx + shift_x
            py = yc + sy + shift_y
            if 0 <= px < width and 0 <= py < height:
                pixels[px, py] = 255

    draw_symmetric(x, y)

    while x < y:
        x += 1
        if d < 0:
            d += 2 * x + 1   # соответствует 2*(x_prev)+3
        else:
            y -= 1
            d += 2 * (x - y) + 1   # соответствует 2*(x_prev - y_prev) + 5
        draw_symmetric(x, y)

    img.save(filename)
    print(f"Окружность сохранена в {filename}")



