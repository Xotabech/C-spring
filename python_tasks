#include <iostream>
#include <fstream>
#include <vector>
#include <string>
#include <algorithm> // для std::min, std::max

// Сохраняет буфер пикселей (одноканальный, 0=чёрный, 255=белый) в бинарный PPM
void savePPM(const std::string& filename, int width, int height,
             const std::vector<unsigned char>& pixels) {
    std::ofstream file(filename, std::ios::binary);
    if (!file) {
        std::cerr << "Ошибка открытия файла " << filename << "\n";
        return;
    }
    file << "P6\n" << width << " " << height << "\n255\n";
    // PPM требует RGB, поэтому дублируем значение серого на все три компонента
    for (unsigned char gray : pixels) {
        file.write(reinterpret_cast<const char*>(&gray), 1);
        file.write(reinterpret_cast<const char*>(&gray), 1);
        file.write(reinterpret_cast<const char*>(&gray), 1);
    }
}

// Алгоритм Брезенхема для отрезка
void drawLine(int x0, int y0, int x1, int y1, const std::string& filename) {
    // Границы холста с отступом
    int minX = std::min(x0, x1);
    int maxX = std::max(x0, x1);
    int minY = std::min(y0, y1);
    int maxY = std::max(y0, y1);
    const int margin = 5;
    int width = maxX - minX + 2 * margin + 1;
    int height = maxY - minY + 2 * margin + 1;

    // Буфер пикселей (чёрный фон)
    std::vector<unsigned char> pixels(width * height, 0);

    int shiftX = -minX + margin;
    int shiftY = -minY + margin;

    int dx = std::abs(x1 - x0);
    int dy = -std::abs(y1 - y0); // обратите внимание: здесь мы берём dy отрицательным
    int sx = x0 < x1 ? 1 : -1;
    int sy = y0 < y1 ? 1 : -1;
    int err = dx + dy; // dx + dy (dy уже отрицательное) = dx - |dy|

    int x = x0, y = y0;
    while (true) {
        int px = x + shiftX;
        int py = y + shiftY;
        if (px >= 0 && px < width && py >= 0 && py < height)
            pixels[py * width + px] = 255;

        if (x == x1 && y == y1) break;
        int e2 = 2 * err;
        if (e2 >= dy) { // dy отрицательное
            err += dy;
            x += sx;
        }
        if (e2 <= dx) {
            err += dx;
            y += sy;
        }
    }

    savePPM(filename, width, height, pixels);
    std::cout << "Отрезок сохранён в " << filename << std::endl;
}

// Алгоритм Брезенхема для окружности
void drawCircle(int xc, int yc, int r, const std::string& filename) {
    int minX = xc - r;
    int maxX = xc + r;
    int minY = yc - r;
    int maxY = yc + r;
    const int margin = 5;
    int width = maxX - minX + 2 * margin + 1;
    int height = maxY - minY + 2 * margin + 1;

    std::vector<unsigned char> pixels(width * height, 0);

    int shiftX = -minX + margin;
    int shiftY = -minY + margin;

    int x = 0, y = r;
    int d = 1 - r;

    // Вспомогательная лямбда для прорисовки 8 симметричных точек
    auto plot = [&](int dx, int dy) {
        int coords[8][2] = {
            {dx, dy}, {-dx, dy}, {dx, -dy}, {-dx, -dy},
            {dy, dx}, {-dy, dx}, {dy, -dx}, {-dy, -dx}
        };
        for (auto& c : coords) {
            int px = xc + c[0] + shiftX;
            int py = yc + c[1] + shiftY;
            if (px >= 0 && px < width && py >= 0 && py < height)
                pixels[py * width + px] = 255;
        }
    };

    plot(x, y);

    while (x < y) {
        x++;
        if (d < 0) {
            d += 2 * x + 1;
        } else {
            y--;
            d += 2 * (x - y) + 1;
        }
        plot(x, y);
    }

    savePPM(filename, width, height, pixels);
    std::cout << "Окружность сохранена в " << filename << std::endl;
}

// Пример использования
int main() {
    drawLine(5, 5, 100, 60, "line.ppm");
    drawCircle(150, 150, 80, "circle.ppm");
    return 0;
}
