from PIL import Image

def draw_line(x0: int, y0: int, x1: int, y1: int, filename: str) -> None:
    """
    Рисует отрезок по алгоритму Брезенхэма и сохраняет в файл.
    """
    # Определяем границы холста с отступом
    min_x = min(x0, x1)
    max_x = max(x0, x1)
    min_y = min(y0, y1)
    max_y = max(y0, y1)
    margin = 5
    width = max_x - min_x + 2 * margin + 1
    height = max_y - min_y + 2 * margin + 1

    # Создаём чёрное изображение
    img = Image.new('L', (width, height), 0)  # 'L' — оттенки серого, 0 = чёрный
    pixels = img.load()

    # Смещение координат для размещения на холсте
    shift_x = -min_x + margin
    shift_y = -min_y + margin

    # Основной алгоритм Брезенхэма
    dx = abs(x1 - x0)
    dy = abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx - dy

    x, y = x0, y0
    while True:
        pixels[x + shift_x, y + shift_y] = 255  # белый пиксель
        if x == x1 and y == y1:
            break
        e2 = 2 * err
        if e2 > -dy:
            err -= dy
            x += sx
        if e2 < dx:
            err += dx
            y += sy

    img.save(filename)
    print(f"Отрезок сохранён в {filename}")


